rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Valida una consulta del formulario de la landing
    function isValidConsulta(c) {
      return c is map
        && c.keys().hasOnly(['Nombre', 'Mail', 'Número', 'Mensaje'])
        && c.Nombre is string && c.Nombre.size() > 0 && c.Nombre.size() <= 100
        && c.Mail is string && c.Mail.size() <= 150
        && c.Mail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && c['Número'] is string && c['Número'].size() > 0 && c['Número'].size() <= 40
        && c.Mensaje is string && c.Mensaje.size() > 0 && c.Mensaje.size() <= 2000;
    }

    // Formulario de contacto: solo se puede AGREGAR una consulta.
    // No se puede leer, borrar, reemplazar el array ni tocar otros campos.
    match /Web/{docId} {
      allow update: if docId == 'Consultas Clientes'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Consultas'])
        && request.resource.data.Consultas is list
        && request.resource.data.Consultas.size() == resource.data.Consultas.size() + 1
        && request.resource.data.Consultas.hasAll(resource.data.Consultas)
        && isValidConsulta(request.resource.data.Consultas[request.resource.data.Consultas.size() - 1]);
    }

    // Todo lo demás queda cerrado (las reglas deniegan por defecto)
  }
}